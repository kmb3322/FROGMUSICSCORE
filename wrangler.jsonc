{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frogmusicscore",
  "compatibility_date": "2026-10-15",
  // /api/* 는 Worker(글·이미지·로그인), 나머지는 정적 파일
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /26FW 같은 주소로 바로 들어와도 index.html → React Router가 처리
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // 글: D1 (SQL)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "frogmusicscore",
      "database_id": "daf97cad-8f4d-4470-a444-d9c153c5bccf",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // 좋아요: 여러 사람이 IP를 나눠 쓰는 통신사망(ASN). 이 망의 IPv4는 IP 대신 브라우저마다 따로 셈
    // 9644 SKT · 4766 KT · 17858/17853 LG U+ · 9318 SK브로드밴드 · 3786 LG데이콤
    "LIKE_SHARED_ASNS": "9644,4766,17858,17853,9318,3786"
  },
  // 이미지: R2
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "frogmusicscoremedia" }]
}
